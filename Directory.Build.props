<Project>

  <!-- Build settings shared by every project (D39). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <!-- Shared test configuration (D45): plain `dotnet test` picks this up, no flags needed. -->
  <PropertyGroup>
    <RunSettingsFilePath>$(MSBuildThisFileDirectory)tests/TechOneNumberToWordsApp.Tests/test.runsettings</RunSettingsFilePath>
  </PropertyGroup>

</Project>
