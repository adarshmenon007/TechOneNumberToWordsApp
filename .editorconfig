# Formatting only (D51): no rule-severity changes, so analyzers cannot become build errors.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yml,yaml,csproj,props,html,css,js,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
